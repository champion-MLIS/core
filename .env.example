# Champion MLIS — environment variables
# Copy this file to .env and fill in real values from 1Password ("Champion Church — Systems" vault).
# Never commit .env. Never paste real secrets into this file.

# ----------------------------------------------------------------------------
# Planning Center Online — Personal Access Token (HTTP Basic auth)
# Generated at https://api.planningcenteronline.com/oauth/applications
# ----------------------------------------------------------------------------
PCO_APP_ID=
PCO_SECRET=

# ----------------------------------------------------------------------------
# Supabase — database for the MLIS
# Project: champion-mlis (us-west-1)
# Dashboard: https://supabase.com/dashboard/project/ubyhnbfvjdcinyhoplsd
#
# SUPABASE_URL          — already filled in below, public, safe to commit if needed
# SUPABASE_SERVICE_ROLE — grab from dashboard → Project Settings → API Keys
#                         (the "service_role" / "secret" key, NOT the publishable key).
#                         This bypasses RLS. Treat it like a master password.
# ----------------------------------------------------------------------------
SUPABASE_URL=https://ubyhnbfvjdcinyhoplsd.supabase.co
SUPABASE_SERVICE_ROLE=

# ----------------------------------------------------------------------------
# Signal classifier overrides (optional)
#
# The signal poller auto-classifies PCO forms by name — "New Here" maps to
# connect_card, "Prayer Request" maps to prayer_request, etc. If Champion
# renames a form or adds one with a non-standard name, paste its PCO form ID
# here (comma-separated for multiple). Discover form IDs via `npm run pco:forms`.
# ----------------------------------------------------------------------------
PCO_CONNECT_CARD_FORM_IDS=
PCO_PRAYER_REQUEST_FORM_IDS=

# ----------------------------------------------------------------------------
# Anthropic API — Claude (drafting and voice-checking guest follow-ups)
#
# Generate at: https://console.anthropic.com/settings/keys
# Use a "workspace key" under the Champion Church workspace, not a personal
# key. Treat like a password.
#
# Model defaults (override if needed):
#   claude-sonnet-4-6           — drafting (better writing)
#   claude-haiku-4-5-20251001   — voice check (faster + cheaper)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_DRAFT_MODEL=claude-sonnet-4-6
ANTHROPIC_VOICE_CHECK_MODEL=claude-haiku-4-5-20251001

# ----------------------------------------------------------------------------
# Champion contact links — used by the follow-up agent when offering 1-2
# relevant next-steps to a new guest. Adjust to match the real URLs.
# ----------------------------------------------------------------------------
CHAMPION_WEBSITE_URL=https://champion.church
CHAMPION_KIDS_URL=https://champion.church/kids
CHAMPION_GROUPS_URL=https://champion.church/groups
CHAMPION_GROWTH_TRACK_URL=https://champion.church/growth-track
