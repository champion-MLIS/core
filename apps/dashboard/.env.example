# Champion MLIS Dashboard — environment variables
# Copy to .env.local for local dev. Never commit .env.local.

# ----------------------------------------------------------------------------
# Supabase
#
# NEXT_PUBLIC_SUPABASE_URL — public; same as the SUPABASE_URL in the CLI .env.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY — the public ("sb_publishable_...") key
#   from the Supabase dashboard. Safe to expose to the browser.
# SUPABASE_SERVICE_ROLE — server-only secret. Same as the CLI's value.
#   NEVER prefix this with NEXT_PUBLIC_ — that would leak it to the browser.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://ubyhnbfvjdcinyhoplsd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE=

# ----------------------------------------------------------------------------
# Auth — domain restriction
#
# Only emails ending in this domain may sign in. The check runs in the auth
# callback; if a user signs in with a non-Champion address we sign them
# out and redirect to /login?error=domain.
# ----------------------------------------------------------------------------
ALLOWED_EMAIL_DOMAIN=championchurch.org

# ----------------------------------------------------------------------------
# Anthropic — for drafting AI-assisted SMS/email touches in Champion's voice.
#
# Same key as the CLI .env. Generate at console.anthropic.com/settings/keys
# under the Champion Church workspace.
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_DRAFT_MODEL=claude-sonnet-4-6
ANTHROPIC_VOICE_CHECK_MODEL=claude-haiku-4-5-20251001

# ----------------------------------------------------------------------------
# Champion's outbound links — the agent picks 1–2 contextually per draft.
# ----------------------------------------------------------------------------
CHAMPION_WEBSITE_URL=https://champion.church
CHAMPION_KIDS_URL=https://champion.church/kids
CHAMPION_GROUPS_URL=https://champion.church/groups
CHAMPION_GROWTH_TRACK_URL=https://champion.church/growth-track

# ----------------------------------------------------------------------------
# Twilio — SMS (outbound touches + inbound "text HOME" keyword webhook).
#
# The same account/number used for outbound sends receives inbound texts.
# Configure the number's "A MESSAGE COMES IN" webhook (HTTP POST) to:
#   https://<this-dashboard-host>/api/sms/inbound
#
# TWILIO_AUTH_TOKEN is required for inbound signature validation — treat like
# a password. Without it (and with validation on) the webhook returns 500.
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+19282488200

# Inbound webhook tuning (Phase F):
#   TWILIO_INBOUND_VALIDATE — set to "false" ONLY for local testing without a
#     real Twilio signature (e.g. curl). Leave unset/"true" in production.
#   TWILIO_INBOUND_URL — the exact public URL Twilio calls. Set this when
#     behind a tunnel/proxy (ngrok, Vercel) where the reconstructed host can
#     drift from what Twilio signed. Leave unset to auto-detect from headers.
TWILIO_INBOUND_VALIDATE=true
TWILIO_INBOUND_URL=

# "Three things to do today" page linked from the inbound auto-reply (Phase F).
# Point this at the real landing page; change it here without a code edit.
CHAMPION_NEXT_STEPS_URL=https://champion.church/next

# ----------------------------------------------------------------------------
# Broadcast processor cron (Phase F.2) — /api/cron/broadcast
#
# The scheduled sweep that mirrors HOME-texters into PCO + enrolls the journey.
# Runs in the dashboard so there's no separate machine. Triggered by Vercel
# Cron (apps/dashboard/vercel.json) or any scheduler/curl with the bearer.
#
#   CRON_SECRET — shared secret. Vercel sends it as `Authorization: Bearer ...`
#     automatically when set. The route rejects calls without it.
#   PCO_APP_ID / PCO_SECRET — needed here (not just the CLI) so the cron can
#     write the minimal PCO person. Same values as the root .env.
#   BROADCAST_PCO_WRITE_ENABLED — master switch (default false). Mirror the
#     root .env value. Flip to true only after the controlled smoke test.
# ----------------------------------------------------------------------------
CRON_SECRET=
PCO_APP_ID=
PCO_SECRET=
BROADCAST_PCO_WRITE_ENABLED=false
