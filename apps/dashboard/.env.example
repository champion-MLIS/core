# Champion MLIS Dashboard — environment variables
# Copy to .env.local for local dev. Never commit .env.local.

# ----------------------------------------------------------------------------
# Supabase
#
# NEXT_PUBLIC_SUPABASE_URL — public; same as the SUPABASE_URL in the CLI .env.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY — the public ("sb_publishable_...") key
#   from the Supabase dashboard. Safe to expose to the browser.
# SUPABASE_SERVICE_ROLE — server-only secret. Same as the CLI's value.
#   NEVER prefix this with NEXT_PUBLIC_ — that would leak it to the browser.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://ubyhnbfvjdcinyhoplsd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE=

# ----------------------------------------------------------------------------
# Auth — domain restriction
#
# Only emails ending in this domain may sign in. The check runs in the auth
# callback; if a user signs in with a non-Champion address we sign them
# out and redirect to /login?error=domain.
# ----------------------------------------------------------------------------
ALLOWED_EMAIL_DOMAIN=championchurch.org
